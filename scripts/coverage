#!/usr/bin/env bash
set -euo pipefail
# In the Hub checkout this runs in its toolchain container (HubTools/hub-run); elsewhere it runs here.
hub_run="$(dirname "$0")/../../../HubTools/hub-run"
[[ -n "${HUB_TOOLCHAIN:-}" || ! -x "$hub_run" ]] || exec "$hub_run" bash "$0" "$@"

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

./gradlew --no-daemon clean jvmTest jacocoJvmReport
mkdir -p coverage
bun scripts/jacoco_to_lcov.mjs build/reports/jacoco/jacocoJvmReport/jacocoJvmReport.xml coverage/lcov.info

echo "LCOV written to $ROOT/coverage/lcov.info"

#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [[ -x /opt/homebrew/opt/openjdk@21/bin/java ]]; then
  export JAVA_HOME="/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
  export PATH="/opt/homebrew/opt/openjdk@21/bin:$PATH"
fi

./gradlew --no-daemon clean jvmTest jacocoJvmReport
mkdir -p coverage
bun scripts/jacoco_to_lcov.mjs build/reports/jacoco/jacocoJvmReport/jacocoJvmReport.xml coverage/lcov.info

echo "LCOV written to $ROOT/coverage/lcov.info"
